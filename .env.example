# Copy to .env and fill in. Used by: bun run gen:assets (Bun loads .env automatically)
GEMINI_API_KEY=
# Optional: another image model, e.g. gemini-3-pro-image (Nano Banana Pro, slower, higher quality)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional: final size of tiling textures (px)
# ASSET_TEX_SIZE=1024
